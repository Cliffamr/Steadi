{
  "name": "veil-browser",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight private browser overlay for Windows screen sharing",
  "license": "MIT",
  "homepage": "https://github.com/Cliffamr/Steadi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cliffamr/Steadi.git"
  },
  "keywords": [
    "browser",
    "screen-sharing",
    "overlay",
    "tauri",
    "webview2",
    "privacy"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "tsc -p tsconfig.test.json && node --test compiled-tests/model.test.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "fmt:rust:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check:all": "npm run check && npm run clippy && npm run fmt:rust"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^25.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^16",
    "typescript": "^5.7",
    "typescript-eslint": "^8",
    "vite": "^6"
  }
}
